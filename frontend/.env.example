# XAMPP Apache: copy Uni-Project/backend/ into htdocs, e.g.:
#   C:\xampp\htdocs\backend\     →  VITE_PROXY_TARGET=http://localhost/backend
#   C:\xampp\htdocs\e-commerce\  →  VITE_PROXY_TARGET=http://localhost/e-commerce
# Start Apache + MySQL in XAMPP, then: npm.cmd run dev
VITE_PROXY_TARGET=http://localhost/backend

# Optional — only if you bypass the proxy (e.g. production build served separately):
# VITE_API_URL=http://localhost/e-commerce/api
# VITE_UPLOADS_URL=http://localhost/e-commerce

# Alternative: PHP built-in server (no Apache). From frontend/ run: npm run backend
# VITE_PROXY_TARGET=http://localhost:8080
